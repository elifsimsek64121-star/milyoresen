  static Future<int> submitAnswer({
    required String duelId,
    required String playerKey,
    required String opponentKey,
    required int questionIdx,
    required int answerIdx,
    required bool correct,
    required int timeMs,
  }) async {
    final duelRef = _db.collection('duels').doc(duelId);
    int awardedPoints = 0;
    try {
      await _db.runTransaction((tx) async {
        final snap = await tx.get(duelRef);
        if (!snap.exists) return;
        final data = snap.data();
        if (data == null) return;

        final myScore = ((data[playerKey]?['score']) ?? 0) as int;
        final oppScore = ((data[opponentKey]?['score']) ?? 0) as int;

        int newMy = myScore;
        int newOpp = oppScore;

        if (correct) {
          final speedBonus = ((15000 - timeMs) / 15000 * kCorrectMaxSpeedBonus)
              .round()
              .clamp(0, kCorrectMaxSpeedBonus);
          awardedPoints = kCorrectBasePoints + speedBonus;
          newMy = myScore + awardedPoints;
        } else {
          awardedPoints = -kWrongPenalty;
          newMy = (myScore - kWrongPenalty) < 0 ? 0 : myScore - kWrongPenalty;
          newOpp = oppScore + kWrongPenalty;
        }

        tx.update(duelRef, {
          '$playerKey.answers': FieldValue.arrayUnion([
            {
              'q': questionIdx,
              'a': answerIdx,
              'correct': correct,
              'points': awardedPoints,
              'timeMs': timeMs,
            },
          ]),
          '$playerKey.score': newMy,
          '$opponentKey.score': newOpp,
        });
      });
    } catch (e) {
      debugPrint('🔴 [ANSWER] $e');
    }
    return awardedPoints;
  }

