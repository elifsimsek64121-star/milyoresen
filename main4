  static Future<bool> forfeitDuel({
    required String duelId,
    required String playerKey,
    required String opponentKey,
  }) async {
    if (uid == null) return false;
    final duelRef = _db.collection('duels').doc(duelId);
    try {
      bool success = false;
      await _db.runTransaction((tx) async {
        final snap = await tx.get(duelRef);
        if (!snap.exists) return;
        final data = snap.data();
        if (data == null) return;
        if (data['status'] == 'finished') return;

        final myScore = ((data[playerKey]?['score']) ?? 0) as int;
        final oppUid = data[opponentKey]?['uid'] as String?;
        if (oppUid == null) return;

        tx.update(duelRef, {
          '$playerKey.score':
              (myScore - kForfeitPenalty) < 0 ? 0 : myScore - kForfeitPenalty,
          '$playerKey.finished': true,
          '$opponentKey.finished': true,
          'status': 'finished',
          'winnerUid': oppUid,
          'forfeitedBy': uid,
          'finishedAt': FieldValue.serverTimestamp(),
        });
        success = true;
      });
      return success;
    } catch (e) {
      debugPrint('🔴 [FORFEIT] $e');
      return false;
    }
  }

  static Future<void> claimDuelReward({
    required String duelId,
    required String playerKey,
    required String? winnerUid,
  }) async {
    if (uid == null) return;
    final currentUid = uid!;
    final duelRef = _db.collection('duels').doc(duelId);
    try {
      final snap = await duelRef.get();
      final data = snap.data();
      if (data == null) return;
      final already = (data[playerKey]?['rewardClaimed'] ?? false) as bool;
      if (already) return;
      await duelRef.update({'$playerKey.rewardClaimed': true});
      final isWin = winnerUid == currentUid;
      final isDraw = winnerUid == 'draw';
      final xpGain = isDraw ? 60 : (isWin ? 150 : 30);
      await _db.collection('users').doc(currentUid).update({
        if (isWin) 'duelsWon': FieldValue.increment(1),
        if (!isWin && !isDraw) 'duelsLost': FieldValue.increment(1),
        if (isDraw) 'duelsDraw': FieldValue.increment(1),
        'xp': FieldValue.increment(xpGain),
        if (isWin) 'coins': FieldValue.increment(50),
        'winStreak': isWin ? FieldValue.increment(1) : 0,
      });
      _checkAchievements(isWin: isWin, isDraw: isDraw);
    } catch (e) {
      debugPrint('🔴 [CLAIM_REWARD] $e');
    }
  }

  static Future<void> _checkAchievements({
    required bool isWin,
    required bool isDraw,
  }) async {
    if (uid == null) return;
    final currentUid = uid!;
    try {
      final snap = await _db.collection('users').doc(currentUid).get();
      final data = snap.data();
      if (data == null) return;
      final won = (data['duelsWon'] ?? 0) as int;
      final streak = (data['winStreak'] ?? 0) as int;
      final achievements = List<String>.from(data['achievements'] ?? []);
      final newAch = <String>[];
      if (won >= 1 && !achievements.contains('first_win')) {
        newAch.add('first_win');
      }
      if (won >= 10 && !achievements.contains('ten_wins')) {
        newAch.add('ten_wins');
      }
      if (won >= 50 && !achievements.contains('fifty_wins')) {
        newAch.add('fifty_wins');
      }
      if (streak >= 5 && !achievements.contains('streak_5')) {
        newAch.add('streak_5');
      }
      if (streak > (data['bestStreak'] ?? 0)) {
        await _db.collection('users').doc(currentUid).update({
          'bestStreak': streak,
        });
      }
      if (newAch.isNotEmpty) {
        await _db.collection('users').doc(currentUid).update({
          'achievements': FieldValue.arrayUnion(newAch),
        });
      }
    } catch (e) {
      debugPrint('🔴 [ACHIEVEMENTS] $e');
    }
  }

  static Future<void> updateStats({
    required bool won,
    required String bestPrize,
    required int correctCount,
    required int totalCount,
  }) async {
    if (uid == null) return;
    try {
      await _db.collection('users').doc(uid!).update({
        'totalGames': FieldValue.increment(1),
        'totalCorrect': FieldValue.increment(correctCount),
        'totalQuestions': FieldValue.increment(totalCount),
        if (won) 'xp': FieldValue.increment(100),
        'bestPrize': bestPrize,
      });
    } catch (e) {
      debugPrint('🔴 [UPDATE_STATS] $e');
    }
  }

  static Future<void> updateTitle(String title) async {
    if (uid == null) return;
    try {
      await _db.collection('users').doc(uid!).update({'activeTitle': title});
    } catch (e) {
      debugPrint('🔴 [UPDATE_TITLE] $e');
    }
  }
}

