class DuelGameScreen extends StatefulWidget {
  final String duelId;
  const DuelGameScreen({super.key, required this.duelId});

  @override
  State<DuelGameScreen> createState() => _DuelGameScreenState();
}

class _DuelGameScreenState extends State<DuelGameScreen>
    with TickerProviderStateMixin {
  Map<String, dynamic>? _duelData;
  StreamSubscription? _duelSub;
  bool _ready = false;
  int _qIdx = 0;
  int _selected = -1;
  bool _answered = false;
  int _timeLeft = 15;
  bool _timeUpDone = false;
  bool _resultShown = false;
  DateTime? _qStartTime;

  bool _usedFifty = false;
  bool _usedSkip = false;
  bool _usedTime = false;
  Set<int> _hiddenOpts = {};

  final TextEditingController _chatC = TextEditingController();
  final ScrollController _chatScroll = ScrollController();
  List<Map<String, dynamic>> _chatMessages = [];
  StreamSubscription? _chatSub;
  bool _chatOpen = false;

  bool _forfeiting = false;

  final AudioPlayer _sfx = AudioPlayer();

  late final AnimationController _timerC = AnimationController(
    vsync: this,
    duration: const Duration(seconds: 15),
  );
  late final AnimationController _qC = AnimationController(
    vsync: this,
    duration: const Duration(milliseconds: 400),
  );
  late final AnimationController _ambientC = AnimationController(
    vsync: this,
    duration: const Duration(seconds: 5),
  )..repeat(reverse: true);

  late final Animation<double> _qFade = CurvedAnimation(
    parent: _qC,
    curve: Curves.easeIn,
  );
  late final Animation<double> _ambient = Tween(
    begin: 0.5,
    end: 1.0,
  ).animate(CurvedAnimation(parent: _ambientC, curve: Curves.easeInOut));

  String get _myKey =>
      (_duelData?['player1']?['uid']) == FirebaseService.uid
          ? 'player1'
          : 'player2';
  String get _oppKey => _myKey == 'player1' ? 'player2' : 'player1';

  List<Map<String, dynamic>> get _questions =>
      (_duelData?['questions'] as List?)?.cast<Map<String, dynamic>>() ?? [];

  @override
  void initState() {
    super.initState();
    _timerC.addListener(_onTimerTick);
    _timerC.addStatusListener(_onTimerStatus);
    _listenDuel();
    _listenChat();
  }

  @override
  void dispose() {
    _duelSub?.cancel();
    _chatSub?.cancel();
    _timerC.dispose();
    _qC.dispose();
    _ambientC.dispose();
    _chatC.dispose();
    _chatScroll.dispose();
    _sfx.dispose();
    super.dispose();
  }

  void _listenDuel() {
    _duelSub = FirebaseService.duelStream(widget.duelId).listen((snap) async {
      if (!mounted) return;
      final data = snap.data();
      if (data == null) return;
      setState(() => _duelData = data);

      final status = data['status'] as String? ?? '';

      if (status == 'starting' && _questions.isEmpty) {
        await _loadAndSetQuestions(data);
      }

      if (status == 'active' && !_ready && _questions.isNotEmpty) {
        setState(() {
          _ready = true;
          _qIdx = 0;
          _selected = -1;
          _answered = false;
          _hiddenOpts = {};
        });
        _qC.forward(from: 0);
        _startTimer();
      }

      if (status == 'active') {
        final myFinished = data[_myKey]?['finished'] == true;
        final oppFinished = data[_oppKey]?['finished'] == true;
        if (myFinished && oppFinished && !_resultShown) {
          _resultShown = true;
          await Future.delayed(const Duration(milliseconds: 400));
          if (mounted) _showResult(data);
        }
      }

      if (status == 'finished' && !_resultShown) {
        _resultShown = true;
        _stopTimer();
        await Future.delayed(const Duration(milliseconds: 400));
        if (mounted) _showResult(data);
      }
    });
  }

  void _listenChat() {
    _chatSub = FirebaseFirestore.instance
        .collection('duels')
        .doc(widget.duelId)
        .collection('chat')
        .orderBy('ts')
        .snapshots()
        .handleError((e) => debugPrint('🔴 [CHAT_STREAM] $e'))
        .listen((snap) {
          if (!mounted) return;
          final msgs = snap.docs.map((d) => d.data()).toList();
          setState(() => _chatMessages = msgs);
          WidgetsBinding.instance.addPostFrameCallback((_) {
            if (_chatScroll.hasClients) {
              _chatScroll.animateTo(
                _chatScroll.position.maxScrollExtent,
                duration: const Duration(milliseconds: 300),
                curve: Curves.easeOut,
              );
            }
          });
        });
  }

  Future<void> _loadAndSetQuestions(Map<String, dynamic> data) async {
    if (_myKey != 'player1') return;
    try {
      final raw =
          json.decode(await rootBundle.loadString('assets/questions.json'))
              as List;
      final all =
          raw.map((e) => Map<String, dynamic>.from(e)).toList()..shuffle();
      final qs =
          all
              .take(10)
              .map(
                (q) => {
                  'question': q['question'],
                  'options': q['options'],
                  'correctAnswer': q['correctAnswer'],
                },
              )
              .toList();
      await FirebaseService.setDuelQuestions(widget.duelId, qs);
    } catch (e) {
      debugPrint('🔴 [DUEL_QS] $e');
    }
  }

  void _onTimerTick() {
    final elapsed = (_timerC.lastElapsedDuration?.inSeconds ?? 0);
    final remaining = 15 - elapsed;
    if (remaining != _timeLeft && mounted) {
      setState(() => _timeLeft = remaining.clamp(0, 15));
    }
  }

  void _onTimerStatus(AnimationStatus s) {
    if (s == AnimationStatus.completed && !_timeUpDone && !_answered) {
      _timeUpDone = true;
      _sound('wrong.mp3');
      _doSubmit(-1);
    }
  }

  void _startTimer([int sec = 15]) {
    _timeUpDone = false;
    _timeLeft = sec;
    _qStartTime = DateTime.now();
    _timerC.duration = Duration(seconds: sec);
    _timerC.forward(from: 0);
  }

  void _stopTimer() => _timerC.stop();

  Future<void> _sound(String f) async {
    try {
      await _sfx.stop();
      await _sfx.setReleaseMode(ReleaseMode.stop);
      await _sfx.setSource(AssetSource('sounds/$f'));
      await _sfx.resume();
    } catch (_) {}
  }

  void _onOptionTap(int i) {
    if (_answered) return;
    if (_selected != -1) return;
    if (_hiddenOpts.contains(i)) return;
    setState(() => _selected = i);
    Future.delayed(const Duration(milliseconds: 900), () {
      if (mounted && !_answered) _doSubmit(_selected);
    });
  }

  Future<void> _doSubmit(int answerIdx) async {
    if (_answered) return;
    _stopTimer();
    setState(() => _answered = true);

    final qs = _questions;
    if (_qIdx >= qs.length) return;

    final q = qs[_qIdx];
    final opts = (q['options'] as List?)?.cast<String>() ?? [];
    final correctIdx = opts.indexOf(q['correctAnswer']?.toString() ?? '');
    final correct = answerIdx == correctIdx;

    if (correct) {
      _sound('correct.mp3');
    } else {
      _sound('wrong.mp3');
    }

    final timeMs =
        _qStartTime != null
            ? DateTime.now()
                .difference(_qStartTime!)
                .inMilliseconds
                .clamp(0, 15000)
            : 15000;

    final awarded = await FirebaseService.submitAnswer(
      duelId: widget.duelId,
      playerKey: _myKey,
      opponentKey: _oppKey,
      questionIdx: _qIdx,
      answerIdx: answerIdx,
      correct: correct,
      timeMs: timeMs,
    );

    if (mounted) {
      if (correct) {
        _snack('✅ Doğru! +$awarded puan', K.correct);
      } else {
        _snack('❌ Yanlış! ${-awarded} puan rakibe gitti', K.wrong);
      }
    }

    await Future.delayed(const Duration(milliseconds: 1400));
    if (!mounted) return;

    if (_qIdx < qs.length - 1) {
      setState(() {
        _qIdx++;
        _selected = -1;
        _answered = false;
        _hiddenOpts = {};
      });
      _qC.forward(from: 0);
      _startTimer();
    } else {
      await FirebaseService.markFinished(widget.duelId, _myKey);
    }
  }

  void _useFifty() {
    if (_usedFifty || _answered || _selected != -1) return;
    final qs = _questions;
    if (_qIdx >= qs.length) return;
    final q = qs[_qIdx];
    final opts = (q['options'] as List?)?.cast<String>() ?? [];
    final correctIdx = opts.indexOf(q['correctAnswer']?.toString() ?? '');
    final wrongs =
        List.generate(
            4,
            (i) => i,
          ).where((i) => i != correctIdx && !_hiddenOpts.contains(i)).toList()
          ..shuffle();
    setState(() {
      _usedFifty = true;
      _hiddenOpts.addAll(wrongs.take(2));
    });
    _sound('correct.mp3');
    _snack('✂️ İki yanlış şık elendi!', K.gold2);
  }

  void _useSkip() {
    if (_usedSkip || _answered) return;
    final qs = _questions;
    if (_qIdx >= qs.length - 1) {
      _snack('Son soruda pas geçemezsiniz.', Colors.orange);
      return;
    }
    setState(() {
      _usedSkip = true;
      _selected = -1;
      _answered = false;
      _hiddenOpts = {};
      _qIdx++;
    });
    _stopTimer();
    _qC.forward(from: 0);
    _startTimer();
    _snack('⏭️ Soru atlandı!', K.cyan);
  }

  void _useTimeLifeline() {
    if (_usedTime || _answered) return;
    _stopTimer();
    setState(() {
      _usedTime = true;
      _timeLeft = (_timeLeft + 10).clamp(0, 30);
    });
    _startTimer(_timeLeft);
    _snack('⏰ +10 saniye eklendi!', Colors.tealAccent);
  }

  Future<void> _sendMessage(String text) async {
    if (text.trim().isEmpty || FirebaseService.uid == null) return;
    final me = _duelData?[_myKey];
    await FirebaseFirestore.instance
        .collection('duels')
        .doc(widget.duelId)
        .collection('chat')
        .add({
          'type': 'text',
          'text': text.trim(),
          'fromUid': FirebaseService.uid,
          'fromName': me?['name'] ?? 'Sen',
          'ts': FieldValue.serverTimestamp(),
        });
    _chatC.clear();
  }

  void _resumeTimer() {
    if (_answered || _resultShown) return;
    _startTimer(_timeLeft);
  }

  void _showForfeitDialog() {
    if (_forfeiting || _resultShown) return;
    _stopTimer();
    showDialog(
      context: context,
      barrierDismissible: false,
      builder:
          (_) => _ForfeitConfirmDialog(
            penalty: FirebaseService.kForfeitPenalty,
            onCancel: () {
              Navigator.pop(context);
              _resumeTimer();
            },
            onConfirm: () async {
              Navigator.pop(context);
              await _doForfeit();
            },
          ),
    );
  }

  Future<void> _doForfeit() async {
    if (_forfeiting || _resultShown) return;
    setState(() => _forfeiting = true);
    final ok = await FirebaseService.forfeitDuel(
      duelId: widget.duelId,
      playerKey: _myKey,
      opponentKey: _oppKey,
    );
    if (!ok && mounted) {
      setState(() => _forfeiting = false);
      _snack('Çekilme işlemi başarısız oldu, tekrar deneyin.', K.wrong);
      return;
    }
  }

  void _showResult(Map<String, dynamic> data) async {
    _stopTimer();
    final myScore = (data[_myKey]?['score'] ?? 0) as int;
    final oppScore = (data[_oppKey]?['score'] ?? 0) as int;
    final winnerUid = data['winnerUid'] as String?;
    final forfeitedBy = data['forfeitedBy'] as String?;

    if (winnerUid == null) {
      final String winner;
      if (myScore > oppScore) {
        winner = FirebaseService.uid!;
      } else if (oppScore > myScore) {
        winner = data[_oppKey]?['uid'] as String? ?? '';
      } else {
        winner = 'draw';
      }
      await FirebaseService.finishDuelWithResult(widget.duelId, winner);
      await FirebaseService.claimDuelReward(
        duelId: widget.duelId,
        playerKey: _myKey,
        winnerUid: winner,
      );
    } else {
      await FirebaseService.claimDuelReward(
        duelId: widget.duelId,
        playerKey: _myKey,
        winnerUid: winnerUid,
      );
    }

    if (!mounted) return;
    final snap = await FirebaseService.duelStream(widget.duelId).first;
    final updated = snap.data() ?? data;
    final finalWinner = updated['winnerUid'] as String? ?? '';
    final wasForfeitByMe = forfeitedBy == FirebaseService.uid;
    final wasForfeitByOpp =
        forfeitedBy != null && forfeitedBy != FirebaseService.uid;

    showDialog(
      context: context,
      barrierDismissible: false,
      builder:
          (_) => _DuelResultDialog(
            isWin: finalWinner == FirebaseService.uid,
            isDraw: finalWinner == 'draw',
            myScore: (updated[_myKey]?['score'] ?? myScore) as int,
            oppScore: (updated[_oppKey]?['score'] ?? oppScore) as int,
            myName: updated[_myKey]?['name'] as String? ?? 'Sen',
            oppName: updated[_oppKey]?['name'] as String? ?? 'Rakip',
            forfeitedByMe: wasForfeitByMe,
            forfeitedByOpponent: wasForfeitByOpp,
            onDone: () => Navigator.popUntil(context, (r) => r.isFirst),
          ),
    );
  }

  void _snack(String msg, Color color) {
    if (!mounted) return;
    ScaffoldMessenger.of(context).clearSnackBars();
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text(msg, style: const TextStyle(fontWeight: FontWeight.w700)),
        backgroundColor: color,
        behavior: SnackBarBehavior.floating,
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(14)),
        margin: const EdgeInsets.all(14),
        duration: const Duration(seconds: 2),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    if (!_ready || _duelData == null || _questions.isEmpty) {
      return _buildWaiting();
    }
    final qs = _questions;
    if (_qIdx >= qs.length) return _buildWaiting();

    final q = qs[_qIdx];
    final opts = (q['options'] as List?)?.cast<String>() ?? [];
    final correctIdx = opts.indexOf(q['correctAnswer']?.toString() ?? '');
    final myScore = (_duelData![_myKey]?['score'] ?? 0) as int;
    final oppScore = (_duelData![_oppKey]?['score'] ?? 0) as int;
    final myName = _duelData![_myKey]?['name'] as String? ?? 'Sen';
    final oppName = _duelData![_oppKey]?['name'] as String? ?? 'Rakip';

    return WillPopScope(
      onWillPop: () async {
        if (_resultShown) return true;
        _showForfeitDialog();
        return false;
      },
      child: Scaffold(
        resizeToAvoidBottomInset: true,
        body: AnimatedBuilder(
          animation: _ambientC,
          builder:
              (_, __) => Stack(
                children: [
                  Positioned.fill(
                    child: Container(
                      decoration: const BoxDecoration(gradient: K.bgGradient),
                    ),
                  ),
                  Positioned.fill(
                    child: CustomPaint(
                      painter: BeamPainter(K.cyan, 0.4 + 0.4 * _ambient.value),
                    ),
                  ),
                  Positioned.fill(
                    child: CustomPaint(painter: ScanlinePainter(1.0)),
                  ),
                  SafeArea(
                    child: Column(
                      children: [
                        _buildTopStrip(),
                        _buildScoreBar(myName, oppName, myScore, oppScore),
                        LinearProgressIndicator(
                          value: (_qIdx + 1) / qs.length,
                          backgroundColor: K.w10,
                          valueColor: const AlwaysStoppedAnimation(K.cyan),
                          minHeight: 3,
                        ),
                        _buildLifelineBar(),
                        Expanded(
                          child:
                              _chatOpen
                                  ? _buildChatPanel()
                                  : FadeTransition(
                                    opacity: _qFade,
                                    child: _buildQuestionPanel(
                                      q,
                                      opts,
                                      correctIdx,
                                    ),
                                  ),
                        ),
                        _buildBottomBar(),
                        // Banner reklam — düello ekranında da her zaman en altta.
                        const AdBottomBar(),
                      ],
                    ),
                  ),
                  if (_forfeiting)
                    Positioned.fill(
                      child: Container(
                        color: Colors.black.withOpacity(0.6),
                        child: const Center(
                          child: Column(
                            mainAxisSize: MainAxisSize.min,
                            children: [
                              CircularProgressIndicator(color: K.wrong),
                              SizedBox(height: 14),
                              Text(
                                'Düellodan çekiliniyor...',
                                style: TextStyle(
                                  color: K.w80,
                                  fontWeight: FontWeight.w700,
                                ),
                              ),
                            ],
                          ),
                        ),
                      ),
                    ),
                ],
              ),
        ),
      ),
    );
  }

  Widget _buildTopStrip() => Padding(
