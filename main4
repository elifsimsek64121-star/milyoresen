      final batch = _db.batch();
      batch.delete(_db.collection('users').doc(currentUid));
      batch.delete(_db.collection('duel_queue').doc(currentUid));
      await batch.commit();
      await u.delete();
      await _google.signOut().catchError((_) {});
      return null; // başarı
    } on FirebaseAuthException catch (e) {
      if (e.code == 'requires-recent-login') {
        return 'Hesabı silmek için tekrar giriş yapmanız gerekiyor.';
      }
      return _parseError(e);
    } catch (e) {
      return 'Hesap silinemedi: $e';
