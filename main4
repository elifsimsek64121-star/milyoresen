class AuthScreen extends StatefulWidget {
  const AuthScreen({super.key});
  @override
  State<AuthScreen> createState() => _AuthScreenState();
}

class _AuthScreenState extends State<AuthScreen> {
  bool _isRegister = false, _loading = false;
  final _emailC = TextEditingController();
  final _passC = TextEditingController();
  final _nameC = TextEditingController();

  @override
  void dispose() {
    _emailC.dispose();
    _passC.dispose();
    _nameC.dispose();
    super.dispose();
  }

  void _snack(String msg, Color color) {
    if (!mounted) return;
    ScaffoldMessenger.of(context).clearSnackBars();
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text(msg),
        backgroundColor: color,
        behavior: SnackBarBehavior.floating,
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(14)),
        margin: const EdgeInsets.all(14),
      ),
    );
  }

  Future<void> _handle(Future<AuthResult> Function() action) async {
    if (_loading) return;
    setState(() => _loading = true);
    final r = await action();
    if (!mounted) return;
    setState(() => _loading = false);
    if (r.ok) {
      Navigator.pushReplacement(
        context,
        MaterialPageRoute(builder: (_) => const DuelLobbyScreen()),
      );
    } else {
      _snack(r.error ?? 'Giriş başarısız.', K.wrong);
    }
  }

  void _submit() {
    final email = _emailC.text.trim(), pass = _passC.text.trim();
    if (email.isEmpty || pass.isEmpty) {
      _snack('E-posta ve şifre gerekli.', K.wrong);
      return;
    }
    if (_isRegister) {
      if (_nameC.text.trim().isEmpty) {
        _snack('Ad soyad gerekli.', K.wrong);
        return;
      }
      _handle(() => FirebaseService.registerEmail(email, pass, _nameC.text));
    } else {
      _handle(() => FirebaseService.signInEmail(email, pass));
    }
  }

  @override
  Widget build(BuildContext context) => Scaffold(
    backgroundColor: K.ink,
    body: Stack(
      children: [
        Positioned.fill(
          child: Image.asset(
            'assets/background.jpg',
            fit: BoxFit.cover,
            errorBuilder: (_, __, ___) => Container(color: K.ink),
          ),
        ),
        Positioned.fill(child: Container(color: K.ink.withOpacity(0.92))),
        SafeArea(
          child: Stack(
            children: [
              Center(
                child: SingleChildScrollView(
                  padding: const EdgeInsets.all(24),
                  child: GlassBox(
                    borderColor: K.gold2,
                    radius: 24,
                    padding: const EdgeInsets.all(26),
                    child: Column(
                      mainAxisSize: MainAxisSize.min,
                      children: [
                        const GoldCoin(size: 56),
                        const SizedBox(height: 14),
                        GoldText(
                          _isRegister ? 'HESAP OLUŞTUR' : 'GİRİŞ YAP',
                          style: const TextStyle(
                            fontSize: 22,
                            fontWeight: FontWeight.w900,
                            letterSpacing: 2,
                          ),
                        ),
                        const SizedBox(height: 6),
                        const Text(
                          'Canlı düello için giriş yapın',
                          textAlign: TextAlign.center,
                          style: TextStyle(color: K.w40, fontSize: 12),
                        ),
                        const SizedBox(height: 22),
                        if (_isRegister) ...[
                          _field(_nameC, 'Ad Soyad', Icons.person_outline),
                          const SizedBox(height: 12),
                        ],
                        _field(
                          _emailC,
                          'E-posta',
                          Icons.alternate_email_rounded,
                        ),
                        const SizedBox(height: 12),
                        _field(
                          _passC,
                          'Şifre',
                          Icons.lock_outline_rounded,
                          obscure: true,
                        ),
                        const SizedBox(height: 20),
                        SizedBox(
                          width: double.infinity,
                          child:
                              _loading
                                  ? const Padding(
                                    padding: EdgeInsets.symmetric(vertical: 14),
                                    child: Center(
                                      child: CircularProgressIndicator(
                                        color: K.gold2,
                                      ),
                                    ),
                                  )
                                  : goldBtn(
                                    _isRegister ? 'Kayıt Ol' : 'Giriş Yap',
                                    _submit,
                                  ),
                        ),
                        const SizedBox(height: 10),
                        TextButton(
                          onPressed:
                              _loading
                                  ? null
                                  : () => setState(
                                    () => _isRegister = !_isRegister,
                                  ),
                          child: Text(
                            _isRegister
                                ? 'Zaten hesabın var mı? Giriş yap'
                                : 'Hesabın yok mu? Kayıt ol',
                            style: const TextStyle(color: K.cyan, fontSize: 13),
                          ),
                        ),
                        const SizedBox(height: 6),
                        Row(
                          children: [
                            Expanded(child: Container(height: 1, color: K.w10)),
                            const Padding(
                              padding: EdgeInsets.symmetric(horizontal: 10),
                              child: Text(
                                'veya',
                                style: TextStyle(color: K.w40, fontSize: 11),
                              ),
                            ),
                            Expanded(child: Container(height: 1, color: K.w10)),
                          ],
