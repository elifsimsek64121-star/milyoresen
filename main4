  Widget _buildTimer() {
    final pct = timeLeft / 30.0;
    final col =
        timeLeft > 20
            ? K.correct
            : timeLeft > 10
            ? Colors.orange
            : K.wrong;
    return AnimatedBuilder(
      animation: _pulseC,
      builder:
          (_, __) => Transform.scale(
            scale: timeLeft <= 10 ? _timerPulse.value : 1.0,
            child: SizedBox(
              width: 66,
              height: 66,
              child: Stack(
                alignment: Alignment.center,
                children: [
                  if (timeLeft <= 10)
