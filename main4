        const SizedBox(height: 2),
        const Text(
          'VS',
          style: TextStyle(color: K.w20, fontSize: 9, letterSpacing: 3),
        ),
      ],
    );
  }

  Widget _buildLifelineBar() {
    return Container(
      height: 56,
      decoration: BoxDecoration(
        color: K.navy.withOpacity(0.9),
        border: const Border(bottom: BorderSide(color: K.w10, width: 1)),
