            ),
          ),
          const SizedBox(height: 12),
          ...List.generate(opts.length, (i) {
            if (_hiddenOpts.contains(i)) {
              return Padding(
                padding: const EdgeInsets.only(bottom: 9),
                child: Container(
                  height: 54,
                  decoration: BoxDecoration(
                    borderRadius: BorderRadius.circular(14),
                    color: K.w05,
                    border: Border.all(color: K.w10, width: 0.5),
                  ),
                ),
              );
            }

            const letters = ['A', 'B', 'C', 'D'];
            final isSel = _selected == i;
            final isCorr = correctIdx == i;

            Color borderCol = K.opts[i];
            bool glow = false;

            if (_answered) {
              if (isCorr) {
                borderCol = K.correct;
                glow = true;
              } else if (isSel && !isCorr) {
                borderCol = K.wrong;
                glow = true;
              } else {
                borderCol = K.opts[i].withOpacity(0.2);
              }
            } else if (isSel) {
              borderCol = K.select;
              glow = true;
            }

            final canTap = !_answered && _selected == -1;

            return Padding(
              padding: const EdgeInsets.only(bottom: 9),
              child: GestureDetector(
                onTap: canTap ? () => _onOptionTap(i) : null,
                child: AnimatedContainer(
                  duration: const Duration(milliseconds: 220),
                  padding: const EdgeInsets.symmetric(
                    horizontal: 14,
                    vertical: 13,
                  ),
                  decoration: BoxDecoration(
                    borderRadius: BorderRadius.circular(14),
                    gradient: LinearGradient(
                      colors:
                          glow
                              ? [
                                borderCol.withOpacity(0.28),
                                borderCol.withOpacity(0.10),
                              ]
                              : [
                                K.panelMid.withOpacity(0.75),
                                K.panel.withOpacity(0.65),
                              ],
                    ),
                    border: Border.all(
                      color:
                          glow
                              ? borderCol
                              : K.opts[i].withOpacity(_answered ? 0.15 : 0.32),
                      width: glow ? 1.8 : 1,
                    ),
                    boxShadow:
                        glow
                            ? [
                              BoxShadow(
                                color: borderCol.withOpacity(0.4),
                                blurRadius: 18,
                              ),
                            ]
                            : [],
                  ),
                  child: Row(
                    children: [
                      Container(
                        width: 36,
                        height: 36,
                        decoration: BoxDecoration(
                          borderRadius: BorderRadius.circular(10),
                          color:
                              glow
                                  ? borderCol.withOpacity(0.3)
                                  : K.opts[i].withOpacity(0.14),
                          border: Border.all(
                            color:
                                glow ? borderCol : K.opts[i].withOpacity(0.4),
                          ),
                        ),
                        alignment: Alignment.center,
                        child: Text(
                          letters[i],
                          style: TextStyle(
                            fontWeight: FontWeight.w900,
                            fontSize: 15,
                            color:
                                glow
                                    ? borderCol
                                    : K.opts[i].withOpacity(
                                      _answered ? 0.3 : 0.85,
                                    ),
                          ),
                        ),
                      ),
                      const SizedBox(width: 12),
                      Expanded(
                        child: Text(
                          opts[i],
                          style: TextStyle(
                            color:
                                _answered
                                    ? (glow ? K.w100 : K.w40)
                                    : (isSel ? K.w100 : K.w80),
                            fontSize: 15,
                            fontWeight:
                                glow ? FontWeight.w600 : FontWeight.w400,
                          ),
                        ),
                      ),
                      if (_answered && isCorr)
                        const Icon(
                          Icons.check_circle_rounded,
                          color: K.correct,
                          size: 22,
                        ),
                      if (_answered && isSel && !isCorr)
                        const Icon(
                          Icons.cancel_rounded,
                          color: K.wrong,
                          size: 22,
                        ),
                    ],
                  ),
                ),
              ),
            );
          }),
        ],
      ),
    );
  }

