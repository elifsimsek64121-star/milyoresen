    with SingleTickerProviderStateMixin {
  late final AnimationController _c = AnimationController(
    vsync: this,
    duration: const Duration(seconds: 4),
  )..repeat(reverse: true);
  Map<String, dynamic>? _profile;
  bool _loading = true;

  static const _achievements = {
    'first_win': ('🥇', 'İlk Galibiyet'),
    'ten_wins': ('🏆', '10 Galibiyet'),
    'fifty_wins': ('👑', '50 Galibiyet'),
    'streak_5': ('🔥', '5 Seri Galibiyet'),
  };

  @override
  void initState() {
    super.initState();
    _load();
  }

  Future<void> _load() async {
    final p = await FirebaseService.getProfile();
    if (mounted)
      setState(() {
        _profile = p;
        _loading = false;
      });
  }

  @override
  void dispose() {
    _c.dispose();
    super.dispose();
  }

  String _xpTitle(int xp) {
    if (xp >= 5000) return 'Efsane';
    if (xp >= 2000) return 'Uzman';
    if (xp >= 1000) return 'Deneyimli';
    if (xp >= 500) return 'Orta Seviye';
    if (xp >= 100) return 'Yeni Başlayan';
    return 'Acemi';
  }

  double _xpProgress(int xp) {
    const milestones = [0, 100, 500, 1000, 2000, 5000, 10000];
    for (int i = 0; i < milestones.length - 1; i++) {
      if (xp < milestones[i + 1]) {
        return (xp - milestones[i]) / (milestones[i + 1] - milestones[i]);
      }
    }
    return 1.0;
  }

