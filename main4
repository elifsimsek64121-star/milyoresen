  static Future<String?> findOrCreateMatch(String roomKey) async {
    if (uid == null) return null;
    final myUid = uid!;
    final me = await getProfile();
    if (me == null) return null;

    await _db.collection('duel_queue').doc(myUid).delete().catchError((_) {});

    final duelId = await _tryMatchFromQueue(roomKey, myUid, me);
    if (duelId != null) return duelId;

    try {
      await _db.collection('duel_queue').doc(myUid).set({
        'uid': myUid,
        'name': me['name'],
        'xp': me['xp'] ?? 0,
        'roomKey': roomKey,
        'status': 'waiting',
        'duelId': null,
        'createdAt': FieldValue.serverTimestamp(),
      });
    } on FirebaseException catch (e) {
      debugPrint('🔴 [QUEUE_WRITE] code=${e.code} message=${e.message}');
      rethrow;
    }

    return null;
  }

  static Future<String?> retryMatch(String roomKey) async {
    if (uid == null) return null;
    final myUid = uid!;
    final myQueueSnap = await _db.collection('duel_queue').doc(myUid).get();
    if (!myQueueSnap.exists) return null;
    final myStatus = myQueueSnap.data()?['status'] as String?;
    if (myStatus != 'waiting') return null;

    final me = await getProfile();
    if (me == null) return null;

    return await _tryMatchFromQueue(roomKey, myUid, me);
  }

  static Future<String?> _tryMatchFromQueue(
    String roomKey,
    String myUid,
    Map<String, dynamic> me,
  ) async {
    final queueRef = _db.collection('duel_queue');
    final duelsRef = _db.collection('duels');

    final QuerySnapshot<Map<String, dynamic>> waiting;
    try {
      waiting = await queueRef
          .where('roomKey', isEqualTo: roomKey)
          .where('status', isEqualTo: 'waiting')
          .limit(10)
          .get()
          .timeout(const Duration(seconds: 8));
    } on FirebaseException catch (e) {
      debugPrint('🔴 [QUEUE_QUERY] code=${e.code} message=${e.message}');
      rethrow;
    }

    final candidates = waiting.docs.where((d) => d.id != myUid).toList();
    if (candidates.isEmpty) return null;

    for (final oppDoc in candidates) {
      String? duelId;
      try {
        await _db.runTransaction((tx) async {
          final fresh = await tx.get(oppDoc.reference);
          if (!fresh.exists || fresh.data()?['status'] != 'waiting') return;
          final oppData = fresh.data()!;
          final duelRef = duelsRef.doc();
          duelId = duelRef.id;

          tx.set(duelRef, {
            'roomKey': roomKey,
            'mode': 'auto',
            'status': 'starting',
            'createdAt': FieldValue.serverTimestamp(),
            'player1': {
              'uid': oppData['uid'],
              'name': oppData['name'],
              'xp': oppData['xp'] ?? 0,
              'activeTitle': oppData['activeTitle'] ?? '',
              'score': 0,
              'answers': <Map<String, dynamic>>[],
              'finished': false,
              'rewardClaimed': false,
            },
            'player2': {
              'uid': myUid,
              'name': me['name'],
              'xp': me['xp'] ?? 0,
              'activeTitle': me['activeTitle'] ?? '',
              'score': 0,
              'answers': <Map<String, dynamic>>[],
              'finished': false,
              'rewardClaimed': false,
            },
            'questions': <Map<String, dynamic>>[],
            'winnerUid': null,
            'forfeitedBy': null,
          });

          tx.update(oppDoc.reference, {'status': 'matched', 'duelId': duelId});
          tx.delete(queueRef.doc(myUid));
        });
      } on FirebaseException catch (e) {
        debugPrint('🔴 [MATCH_TX] code=${e.code} message=${e.message}');
        duelId = null;
        if (e.code == 'permission-denied' || e.code == 'failed-precondition') {
          rethrow;
        }
      } catch (e) {
        debugPrint('🔴 [MATCH_TX] $e');
        duelId = null;
      }
      if (duelId != null) return duelId;
    }
    return null;
  }

