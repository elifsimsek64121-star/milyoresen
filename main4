// ══════════════════════════════════════════════
class DuelLobbyScreen extends StatefulWidget {
  const DuelLobbyScreen({super.key});
  @override
  State<DuelLobbyScreen> createState() => _DuelLobbyScreenState();
}

class _DuelLobbyScreenState extends State<DuelLobbyScreen>
    with SingleTickerProviderStateMixin {
  late final AnimationController _ambientC = AnimationController(
    vsync: this,
    duration: const Duration(seconds: 4),
  )..repeat(reverse: true);
  late final Animation<double> _ambient = Tween(
    begin: 0.6,
    end: 1.0,
  ).animate(CurvedAnimation(parent: _ambientC, curve: Curves.easeInOut));

  bool _loading = false;
  bool _searching = false;
  StreamSubscription? _queueSub;
  Timer? _searchTimeout;
  int _searchSeconds = 0;
  Timer? _searchTimer;

  Timer? _retryTimer;
  bool _matchResolved = false;

  static const String _roomKey = 'default';

  @override
  void dispose() {
    _ambientC.dispose();
    _queueSub?.cancel();
    _searchTimeout?.cancel();
    _searchTimer?.cancel();
    _retryTimer?.cancel();
    super.dispose();
  }

  void _snack(String msg, Color color) {
    if (!mounted) return;
    ScaffoldMessenger.of(context).clearSnackBars();
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text(msg, style: const TextStyle(fontWeight: FontWeight.w700)),
        backgroundColor: color,
        behavior: SnackBarBehavior.floating,
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(14)),
        margin: const EdgeInsets.all(14),
      ),
    );
  }

  Future<void> _quickMatch() async {
    if (FirebaseService.user == null) {
      Navigator.push(
        context,
        MaterialPageRoute(builder: (_) => const AuthScreen()),
      );
      return;
    }
    setState(() {
      _loading = true;
      _searching = true;
      _searchSeconds = 0;
      _matchResolved = false;
    });

    _searchTimer = Timer.periodic(const Duration(seconds: 1), (t) {
      if (mounted) setState(() => _searchSeconds++);
    });

    try {
      final duelId = await FirebaseService.findOrCreateMatch(_roomKey);
      if (!mounted) return;

      if (duelId != null) {
        _finishSearch(duelId);
        return;
      }

      _queueSub = FirebaseService.watchMyQueueDoc().listen((snap) async {
        if (!mounted || _matchResolved) return;
        final data = snap.data();
        if (data == null) return;
        if (data['status'] == 'matched' && data['duelId'] != null) {
          _finishSearch(data['duelId'] as String);
        }
      });

      _retryTimer = Timer.periodic(const Duration(seconds: 3), (t) async {
        if (!mounted || _matchResolved) {
          t.cancel();
          return;
        }
        try {
          final id = await FirebaseService.retryMatch(_roomKey);
          if (id != null && mounted && !_matchResolved) {
            _finishSearch(id);
          }
        } on FirebaseException catch (e) {
          if (e.code == 'permission-denied' ||
              e.code == 'failed-precondition') {
            t.cancel();
            _matchResolved = true;
            _queueSub?.cancel();
            _searchTimeout?.cancel();
            _searchTimer?.cancel();
            await FirebaseService.cancelMatchmaking();
            if (mounted) {
              setState(() {
                _loading = false;
                _searching = false;
              });
              _snack(
                e.code == 'permission-denied'
                    ? 'Eşleştirme reddedildi: Firestore güvenlik kuralları '
                        'düzeltilmeli (duel_queue koleksiyonu).'
                    : 'Sunucuda eksik bir indeks var, biraz sonra tekrar '
                        'deneyin.',
                K.wrong,
              );
            }
          }
        } catch (e) {
          debugPrint('🔴 [RETRY_MATCH] $e');
        }
      });

      _searchTimeout = Timer(const Duration(seconds: 60), () async {
        if (_matchResolved) return;
        _queueSub?.cancel();
        _searchTimer?.cancel();
        _retryTimer?.cancel();
        await FirebaseService.cancelMatchmaking();
        if (mounted) {
          setState(() {
            _loading = false;
            _searching = false;
          });
          _snack('Rakip bulunamadı. Tekrar deneyin.', Colors.orange);
        }
      });
    } catch (e) {
      _searchTimer?.cancel();
      _retryTimer?.cancel();
      if (mounted) {
        setState(() {
          _loading = false;
          _searching = false;
        });
      }
      if (e is FirebaseException && e.code == 'permission-denied') {
        _snack(
          'Eşleştirme reddedildi: Firestore güvenlik kuralları '
          'duel_queue koleksiyonunda başka bir oyuncunun kaydını '
          'güncellemenize izin vermiyor. Kuralları güncelleyin.',
          K.wrong,
        );
      } else if (e is FirebaseException && e.code == 'failed-precondition') {
        _snack(
          'Sunucuda eksik bir Firestore indeksi var. Debug konsolundaki '
          'linke tıklayıp indeksi oluşturun.',
          K.wrong,
        );
      } else {
        _snack('Hata: $e', K.wrong);
      }
    }
  }

  void _finishSearch(String duelId) {
    if (_matchResolved) return;
    _matchResolved = true;
    _queueSub?.cancel();
    _searchTimeout?.cancel();
    _searchTimer?.cancel();
    _retryTimer?.cancel();
    if (mounted) {
      setState(() {
        _loading = false;
        _searching = false;
      });
      _goToDuelGame(duelId);
    }
  }

  void _cancelSearch() async {
    _matchResolved = true;
    _queueSub?.cancel();
    _searchTimeout?.cancel();
    _searchTimer?.cancel();
    _retryTimer?.cancel();
    await FirebaseService.cancelMatchmaking();
    if (mounted) {
      setState(() {
        _loading = false;
        _searching = false;
        _searchSeconds = 0;
      });
      _snack('Arama iptal edildi.', K.w60);
    }
  }

