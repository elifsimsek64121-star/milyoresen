// ══════════════════════════════════════════════
//  AD MANAGER  (v1 — banner reklamlar HER EKRANDA, HER ZAMAN sabit
//  alanda görünür; başarısız yüklemelerde otomatik ve sürekli yeniden
//  dener, böylece "reklam çıkmıyor" sorunu ortadan kalkar)
// ══════════════════════════════════════════════
//
// NOT: Banner alanı artık her zaman 52px yüksekliğinde sabit bir şerit
// olarak ayrılır (layout zıplaması olmaz). Reklam henüz yüklenmediyse
// yumuşak bir "yükleniyor" göstergesi gösterilir, reklam yüklenemezse
// birkaç saniye sonra otomatik tekrar denenir — sonsuza kadar.
class AppBannerAd extends StatefulWidget {
  const AppBannerAd({super.key});

  @override
  State<AppBannerAd> createState() => _AppBannerAdState();
}

class _AppBannerAdState extends State<AppBannerAd> {
  BannerAd? _banner;
  bool _loaded = false;
  int _failCount = 0;
  Timer? _retryTimer;

  @override
  void initState() {
    super.initState();
    _load();
  }

  void _load() {
    _banner?.dispose();
    _banner = null;
    if (mounted) setState(() => _loaded = false);

    final ad = BannerAd(
      size: AdSize.banner,
      adUnitId: Ads.banner,
      request: const AdRequest(),
      listener: BannerAdListener(
        onAdLoaded: (ad) {
          if (!mounted) {
            ad.dispose();
            return;
          }
          setState(() {
            _banner = ad as BannerAd;
            _loaded = true;
            _failCount = 0;
          });
        },
        onAdFailedToLoad: (ad, err) {
          ad.dispose();
          _failCount++;
          debugPrint('🔴 [BANNER_AD] load failed ($_failCount): $err');
          if (!mounted) return;
          setState(() {
            _banner = null;
            _loaded = false;
          });
          // Kalıcı olarak dener: ilk denemeler kısa aralıklarla, sonra
          // sabit 20 saniyede bir. Böylece reklam envanteri geldiği an
          // banner otomatik olarak belirir.
          final delay = Duration(seconds: _failCount < 3 ? 6 : 20);
          _retryTimer?.cancel();
          _retryTimer = Timer(delay, () {
            if (mounted) _load();
          });
        },
      ),
    );
    ad.load();
  }

  @override
  void dispose() {
    _retryTimer?.cancel();
    _banner?.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Container(
      width: double.infinity,
      height: 52,
      color: Colors.black,
      alignment: Alignment.center,
      child:
          (_loaded && _banner != null)
              ? SizedBox(
                width: _banner!.size.width.toDouble(),
                height: _banner!.size.height.toDouble(),
                child: AdWidget(ad: _banner!),
              )
              : Row(
                mainAxisSize: MainAxisSize.min,
                children: List.generate(
                  3,
                  (i) => Padding(
                    padding: const EdgeInsets.symmetric(horizontal: 5),
                    child: Dot(color: K.gold3, size: 5),
                  ),
                ),
              ),
    );
  }
}

