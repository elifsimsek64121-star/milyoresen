class _AuthScreenState extends State<AuthScreen> {
  bool _isRegister = false, _loading = false;
  final _emailC = TextEditingController();
  final _passC = TextEditingController();
  final _nameC = TextEditingController();

  @override
  void dispose() {
    _emailC.dispose();
    _passC.dispose();
    _nameC.dispose();
    super.dispose();
  }

  void _snack(String msg, Color color) {
    if (!mounted) return;
    ScaffoldMessenger.of(context).clearSnackBars();
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text(msg),
        backgroundColor: color,
        behavior: SnackBarBehavior.floating,
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(14)),
        margin: const EdgeInsets.all(14),
      ),
    );
  }

  Future<void> _handle(Future<AuthResult> Function() action) async {
    if (_loading) return;
    setState(() => _loading = true);
    final r = await action();
    if (!mounted) return;
    setState(() => _loading = false);
    if (r.ok) {
      Navigator.pushReplacement(
        context,
        MaterialPageRoute(builder: (_) => const DuelLobbyScreen()),
      );
    } else {
      _snack(r.error ?? 'Giriş başarısız.', K.wrong);
    }
  }

  void _submit() {
    final email = _emailC.text.trim(), pass = _passC.text.trim();
    if (email.isEmpty || pass.isEmpty) {
      _snack('E-posta ve şifre gerekli.', K.wrong);
      return;
    }
    if (_isRegister) {
      if (_nameC.text.trim().isEmpty) {
        _snack('Ad soyad gerekli.', K.wrong);
        return;
      }
      _handle(() => FirebaseService.registerEmail(email, pass, _nameC.text));
    } else {
      _handle(() => FirebaseService.signInEmail(email, pass));
    }
  }

