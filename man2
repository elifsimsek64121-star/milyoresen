class AuthResult {
  final User? user;
  final String? error;
  const AuthResult(this.user, this.error);
  bool get ok => user != null;
}

// ══════════════════════════════════════════════
//  FIREBASE SERVICE
// ══════════════════════════════════════════════
class FirebaseService {
  static final _auth = FirebaseAuth.instance;
  static final _db = FirebaseFirestore.instance;
  static final _google = GoogleSignIn();

  static User? get user => _auth.currentUser;
  static String? get uid => user?.uid;
  static bool get isGuest => user?.isAnonymous ?? false;

  static Future<AuthResult> signInGoogle() async {
    try {
      await _google.signOut().catchError((_) {});
      final acc = await _google.signIn();
      if (acc == null) return const AuthResult(null, 'Giriş iptal edildi.');
      final g = await acc.authentication;
      if (g.idToken == null)
        return const AuthResult(null, 'Google token alınamadı.');
      final cred = GoogleAuthProvider.credential(
        accessToken: g.accessToken,
        idToken: g.idToken,
      );
      final r = await _auth.signInWithCredential(cred);
      await _ensureProfile(r.user);
      return AuthResult(r.user, null);
    } catch (e) {
      return AuthResult(null, _parseError(e));
    }
  }

  static Future<AuthResult> signInGuest() async {
    try {
      final r = await _auth.signInAnonymously();
      await _ensureProfile(r.user, displayName: 'Misafir');
      return AuthResult(r.user, null);
    } catch (e) {
      return AuthResult(null, _parseError(e));
    }
  }

  static Future<AuthResult> signInEmail(String email, String pass) async {
    try {
      final r = await _auth.signInWithEmailAndPassword(
        email: email.trim(),
        password: pass.trim(),
      );
      await _ensureProfile(r.user);
      return AuthResult(r.user, null);
    } catch (e) {
      return AuthResult(null, _parseError(e));
    }
  }

  static Future<AuthResult> registerEmail(
    String email,
    String pass,
    String name,
  ) async {
    try {
      final r = await _auth.createUserWithEmailAndPassword(
        email: email.trim(),
        password: pass.trim(),
      );
      await r.user?.updateDisplayName(name.trim());
      await _ensureProfile(r.user, displayName: name.trim());
      return AuthResult(r.user, null);
    } catch (e) {
      return AuthResult(null, _parseError(e));
    }
  }

  static Future<void> signOut() async {
    await _google.signOut().catchError((_) {});
    await _auth.signOut();
  }

  static String _parseError(Object err) {
    if (err is FirebaseAuthException) {
      switch (err.code) {
        case 'user-not-found':
          return 'Bu e-posta ile kayıtlı kullanıcı bulunamadı.';
        case 'wrong-password':
        case 'invalid-credential':
          return 'Şifre veya e-posta yanlış.';
        case 'email-already-in-use':
          return 'Bu e-posta zaten kullanımda.';
        case 'weak-password':
          return 'Şifre en az 6 karakter olmalı.';
        case 'invalid-email':
          return 'Geçersiz e-posta adresi.';
        case 'too-many-requests':
          return 'Çok fazla deneme. Lütfen bekleyin.';
        case 'network-request-failed':
          return 'İnternet bağlantınızı kontrol edin.';
        default:
          return err.message ?? 'Giriş başarısız (${err.code}).';
      }
    }
    return 'Bir hata oluştu: $err';
  }

  static Future<void> _ensureProfile(User? u, {String? displayName}) async {
    if (u == null) return;
    final ref = _db.collection('users').doc(u.uid);
    try {
      final snap = await ref.get().timeout(const Duration(seconds: 12));
      final name = displayName ?? u.displayName ?? 'Oyuncu';
      if (!snap.exists) {
        await ref.set({
          'uid': u.uid,
          'name': name,
          'nameLower': name.toLowerCase(),
          'email': u.email ?? '',
          'photoUrl': u.photoURL ?? '',
          'xp': 0,
          'coins': 100,
          'totalCorrect': 0,
          'totalGames': 0,
          'duelsWon': 0,
          'duelsLost': 0,
          'bestPrize': '0',
          'isGuest': u.isAnonymous,
          'isPremium': false,
          'createdAt': FieldValue.serverTimestamp(),
          'lastLogin': FieldValue.serverTimestamp(),
        });
      } else {
        await ref.update({'lastLogin': FieldValue.serverTimestamp()});
      }
    } catch (e) {
      debugPrint('🔴 [PROFILE] $e');
    }
  }

  static Future<Map<String, dynamic>?> getProfile() async {
    if (uid == null) return null;
    try {
      final s = await _db
          .collection('users')
          .doc(uid)
          .get()
          .timeout(const Duration(seconds: 10));
      return s.data();
    } catch (_) {
      return null;
    }
  }

  static Stream<DocumentSnapshot<Map<String, dynamic>>> profileStream() =>
      _db.collection('users').doc(uid).snapshots();

  static Future<List<Map<String, dynamic>>> searchPlayers(String query) async {
    final q = query.trim().toLowerCase();
    if (q.isEmpty || uid == null) return [];
    try {
      final s = await _db
          .collection('users')
          .orderBy('nameLower')
          .startAt([q])
          .endAt(['$q\uf8ff'])
          .limit(15)
          .get()
          .timeout(const Duration(seconds: 8));
      return s.docs
          .where((d) => d.id != uid)
          .map((d) => {...d.data(), 'uid': d.id})
          .toList();
    } catch (e) {
      debugPrint('🔴 [SEARCH] $e');
      return [];
    }
  }

  static Future<List<Map<String, dynamic>>> getLeaderboard({
    int limit = 50,
  }) async {
    try {
      final s = await _db
          .collection('users')
          .orderBy('xp', descending: true)
          .limit(limit)
          .get()
          .timeout(const Duration(seconds: 10));
      return s.docs.map((d) => {...d.data(), 'uid': d.id}).toList();
    } catch (_) {
      return [];
    }
  }

  static Future<String?> findOrCreateMatch(String roomKey) async {
    if (uid == null) return null;
    final me = await getProfile();
    if (me == null) return null;
    final queueRef = _db.collection('duel_queue');
    final duelsRef = _db.collection('duels');
    try {
      final waiting = await queueRef
          .where('roomKey', isEqualTo: roomKey)
          .where('status', isEqualTo: 'waiting')
          .limit(10)
          .get()
          .timeout(const Duration(seconds: 8));
      final candidate = waiting.docs.where((d) => d.id != uid).toList();
      if (candidate.isNotEmpty) {
        final oppDoc = candidate.first;
        String? duelId;
        await _db.runTransaction((tx) async {
          final fresh = await tx.get(oppDoc.reference);
          if (!fresh.exists || fresh.data()?['status'] != 'waiting') return;
          final oppData = fresh.data()!;
          final duelRef = duelsRef.doc();
          duelId = duelRef.id;
          tx.set(duelRef, {
            'roomKey': roomKey,
            'mode': 'auto',
            'status': 'starting',
            'createdAt': FieldValue.serverTimestamp(),
            'player1': {
              'uid': oppData['uid'],
              'name': oppData['name'],
              'xp': oppData['xp'] ?? 0,
              'score': 0,
              'answers': <Map<String, dynamic>>[],
              'finished': false,
            },
            'player2': {
              'uid': uid,
              'name': me['name'],
              'xp': me['xp'] ?? 0,
              'score': 0,
              'answers': <Map<String, dynamic>>[],
              'finished': false,
            },
            'questions': <Map<String, dynamic>>[],
            'winnerUid': null,
          });
          tx.update(oppDoc.reference, {'status': 'matched', 'duelId': duelId});
        });
        if (duelId != null) {
          await _cleanMyQueue();
          return duelId;
        }
      }
      await queueRef.doc(uid).set({
        'uid': uid,
        'name': me['name'],
        'xp': me['xp'] ?? 0,
        'roomKey': roomKey,
        'status': 'waiting',
        'duelId': null,
        'createdAt': FieldValue.serverTimestamp(),
      });
      return null;
    } catch (e) {
      debugPrint('🔴 [MATCHMAKING] $e');
      return null;
    }
  }

  static Stream<DocumentSnapshot<Map<String, dynamic>>> watchMyQueueDoc() =>
      _db.collection('duel_queue').doc(uid).snapshots();

  static Future<void> _cleanMyQueue() async {
    if (uid == null) return;
    try {
      await _db.collection('duel_queue').doc(uid).delete();
    } catch (_) {}
  }

  static Future<void> cancelMatchmaking() => _cleanMyQueue();

  static Future<String?> createDuel(String roomKey) async {
    if (uid == null) return null;
    final me = await getProfile();
    if (me == null) return null;
    try {
      final ref = await _db.collection('duels').add({
        'roomKey': roomKey,
        'mode': 'manual',
        'status': 'waiting',
        'createdAt': FieldValue.serverTimestamp(),
        'player1': {
          'uid': uid,
          'name': me['name'],
          'xp': me['xp'] ?? 0,
          'score': 0,
          'answers': <Map<String, dynamic>>[],
          'finished': false,
        },
        'player2': null,
        'questions': <Map<String, dynamic>>[],
        'winnerUid': null,
      });
      return ref.id;
    } catch (e) {
      debugPrint('🔴 [CREATE_DUEL] $e');
      return null;
    }
  }

  static Future<bool> joinDuelByCode(String duelId) async {
    if (uid == null) return false;
    final me = await getProfile();
    if (me == null) return false;
    try {
      final ref = _db.collection('duels').doc(duelId);
      final snap = await ref.get();
      if (!snap.exists) return false;
      final data = snap.data()!;
      if (data['status'] != 'waiting' || data['player2'] != null) return false;
      await ref.update({
        'status': 'starting',
        'player2': {
          'uid': uid,
          'name': me['name'],
          'xp': me['xp'] ?? 0,
          'score': 0,
          'answers': <Map<String, dynamic>>[],
          'finished': false,
        },
      });
      return true;
    } catch (e) {
      debugPrint('🔴 [JOIN_DUEL] $e');
      return false;
    }
  }

  static Future<List<Map<String, dynamic>>> findOpenDuels(
    String roomKey,
  ) async {
    try {
      final s = await _db
          .collection('duels')
          .where('roomKey', isEqualTo: roomKey)
          .where('status', isEqualTo: 'waiting')
          .where('mode', isEqualTo: 'manual')
          .orderBy('createdAt', descending: true)
          .limit(20)
          .get()
          .timeout(const Duration(seconds: 10));
      return s.docs
          .where((d) => (d.data()['player1']?['uid']) != uid)
          .map((d) => {...d.data(), 'id': d.id})
          .toList();
    } catch (_) {
      return [];
    }
  }

  static Future<String?> sendDuelInvite(
    Map<String, dynamic> toUser,
    String roomKey,
  ) async {
    if (uid == null) return null;
    final me = await getProfile();
    if (me == null) return null;
    try {
      final duelRef = _db.collection('duels').doc();
      await duelRef.set({
        'roomKey': roomKey,
        'mode': 'invite',
        'status': 'waiting',
        'createdAt': FieldValue.serverTimestamp(),
        'player1': {
          'uid': uid,
          'name': me['name'],
          'xp': me['xp'] ?? 0,
          'score': 0,
          'answers': <Map<String, dynamic>>[],
          'finished': false,
        },
        'player2': null,
        'questions': <Map<String, dynamic>>[],
        'winnerUid': null,
      });
      await _db.collection('duel_invites').add({
        'duelId': duelRef.id,
        'fromUid': uid,
        'fromName': me['name'],
        'toUid': toUser['uid'],
        'status': 'pending',
        'createdAt': FieldValue.serverTimestamp(),
      });
      return duelRef.id;
    } catch (e) {
      debugPrint('🔴 [INVITE] $e');
      return null;
    }
  }

  static Stream<QuerySnapshot<Map<String, dynamic>>> watchMyInvites() {
    if (uid == null) return const Stream.empty();
    return _db
        .collection('duel_invites')
        .where('toUid', isEqualTo: uid)
        .where('status', isEqualTo: 'pending')
        .snapshots();
  }

  static Future<bool> acceptInvite(String inviteId, String duelId) async {
    final ok = await joinDuelByCode(duelId);
    if (ok)
      await _db.collection('duel_invites').doc(inviteId).update({
        'status': 'accepted',
      });
    return ok;
  }

  static Future<void> declineInvite(String inviteId) async {
    try {
      await _db.collection('duel_invites').doc(inviteId).update({
        'status': 'declined',
      });
    } catch (_) {}
  }

  static Stream<DocumentSnapshot<Map<String, dynamic>>> duelStream(
    String duelId,
  ) => _db.collection('duels').doc(duelId).snapshots();

  static Future<void> setDuelQuestions(
    String duelId,
    List<Map<String, dynamic>> qs,
  ) async {
    try {
      await _db.collection('duels').doc(duelId).update({
        'questions': qs,
        'status': 'active',
        'startedAt': FieldValue.serverTimestamp(),
      });
    } catch (_) {}
  }

  static Future<void> submitAnswer({
    required String duelId,
    required String playerKey,
    required int questionIdx,
    required int answerIdx,
    required bool correct,
    required int timeMs,
  }) async {
    final speedBonus = correct
        ? ((15000 - timeMs) / 15000 * 500).round().clamp(0, 500)
        : 0;
    final points = (correct ? 500 : 0) + speedBonus;
    try {
      await _db.collection('duels').doc(duelId).update({
        '$playerKey.answers': FieldValue.arrayUnion([
          {
            'q': questionIdx,
            'a': answerIdx,
            'correct': correct,
            'points': points,
            'timeMs': timeMs,
          },
        ]),
        '$playerKey.score': FieldValue.increment(points),
      });
    } catch (e) {
      debugPrint('🔴 [ANSWER] $e');
    }
  }

  static Future<void> markFinished(String duelId, String playerKey) async {
    try {
      await _db.collection('duels').doc(duelId).update({
        '$playerKey.finished': true,
      });
    } catch (_) {}
  }

  static Future<void> finishDuelWithResult(
    String duelId,
    String winnerUid,
  ) async {
    try {
      final ref = _db.collection('duels').doc(duelId);
      final snap = await ref.get();
      if (snap.data()?['status'] == 'finished') return;
      await ref.update({
        'status': 'finished',
        'winnerUid': winnerUid,
        'finishedAt': FieldValue.serverTimestamp(),
      });
    } catch (e) {
      debugPrint('🔴 [FINISH_DUEL] $e');
    }
  }

  static Future<void> claimDuelReward({
    required String duelId,
    required String playerKey,
    required String? winnerUid,
  }) async {
    if (uid == null) return;
    final duelRef = _db.collection('duels').doc(duelId);
    try {
      final snap = await duelRef.get();
      final data = snap.data();
      if (data == null) return;
      final already = (data['$playerKey']?['rewardClaimed'] ?? false) as bool;
      if (already) return;
      await duelRef.update({'$playerKey.rewardClaimed': true});
      final isWin = winnerUid == uid;
      final isDraw = winnerUid == 'draw';
      final xpGain = isDraw ? 60 : (isWin ? 150 : 30);
      await _db.collection('users').doc(uid!).update({
        if (isWin) 'duelsWon': FieldValue.increment(1),
        if (!isWin && !isDraw) 'duelsLost': FieldValue.increment(1),
        'xp': FieldValue.increment(xpGain),
        if (isWin) 'coins': FieldValue.increment(50),
      });
    } catch (e) {
      debugPrint('🔴 [CLAIM_REWARD] $e');
    }
  }

  static Future<void> updateStats({
    required bool won,
    required String bestPrize,
  }) async {
    if (uid == null) return;
    try {
      await _db.collection('users').doc(uid!).update({
        'totalGames': FieldValue.increment(1),
        if (won) 'xp': FieldValue.increment(100),
        'bestPrize': bestPrize,
      });
    } catch (_) {}
  }
}

