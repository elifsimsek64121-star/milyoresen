    if (FirebaseService.user == null) {
      Navigator.push(
        context,
        MaterialPageRoute(builder: (_) => const AuthScreen()),
      );
      return;
    }
    setState(() => _loading = true);
    try {
      final duelId = await FirebaseService.findOrCreateMatch('default');
      if (!mounted) return;
      if (duelId != null) {
        _snack('Rakip bulundu! Oyun başlıyor...', K.correct);
      } else {
        _snack('Rakip aranıyor... Lütfen bekleyin.', K.cyan);
